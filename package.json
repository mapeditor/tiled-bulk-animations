{
  "name": "tiled-bulk-animations",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest",
    "husky": "^9.1.7"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "scripts": {
    "prepare": "husky",
    "build": "bun ./src/utility/build.ts && bun minify",
    "minify": "bun build --minify ./dist/bulk-animations/index.mjs --outfile=./dist/bulk-animations/index.mjs && bun build --minify ./dist/bulk-animations/cache.mjs --outfile=./dist/bulk-animations/cache.mjs"
  }
}
